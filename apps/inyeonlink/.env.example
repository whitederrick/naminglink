# 인연링크 환경변수.
#
# **필수 변수가 없다.** 아무것도 설정하지 않아도 궁합 계산은 그대로 동작한다(무료 조회는
# 저장소도 결제도 쓰지 않는다). 아래는 전부 광고와 유료 PDF 판매용이고, 미설정이면 그 기능이
# 꺼진 채 배포된다 — 스크립트도, /ads.txt도, CSP 완화도 붙지 않는다.
#
# 주의: NEXT_PUBLIC_ 변수는 빌드 시점에 클라이언트 번들에 박힌다. Vercel에서 값을 넣은 뒤에는
# 반드시 **재배포**해야 반영된다.

# 애드센스 퍼블리셔 ID. 형식이 맞아야만 광고가 켜진다(ca-pub- + 숫자).
# 심사를 통과해야 발급되므로 처음에는 비워 둔다.
NEXT_PUBLIC_ADSENSE_CLIENT=

# 광고 단위(슬롯) ID. 애드센스 콘솔에서 자리마다 하나씩 만든다.
# 슬롯이 비어 있으면 그 자리만 렌더링하지 않으므로, 한 자리씩 켜 볼 수 있다.
# 결과 화면 — 결과를 다 읽은 뒤
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=
# 입력 화면 — 맨 아래(제출 버튼과 떨어진 자리)
NEXT_PUBLIC_ADSENSE_SLOT_FORM=
# 보상형 광고("광고 보고 결과 보기") 자리. 이 값이 있어야 게이트가 선다.
NEXT_PUBLIC_ADSENSE_SLOT_ANALYZING=

# ── 유료 PDF 판매 (궁합 리포트: 국내 990원 / 해외 US$2.99) ─────────────────────
#
# 주문은 naminglink와 **같은 Supabase, 같은 public.orders**에 쌓이고 service 컬럼으로
# 갈린다(포트원 상점이 하나이기 때문). 그래서 아래 값들도 naminglink와 같은 것을 쓴다.
#
# 가격과 판매 여부는 코드가 아니라 DB(product_settings)가 정한다. 지금은 enabled=false로
# 시드돼 있어 값을 다 넣어도 판매가 열리지 않는다 — naminglink 관리자 화면에서 켜야 한다.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_PORTONE_STORE_ID=
# 국내(카카오페이). 없으면 아래 단일 채널 키로 폴백한다.
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_KAKAOPAY=
# 해외(페이팔)
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_PAYPAL=
# 테스트 채널 하나로 쓰던 구성용 폴백
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# 테스트 채널 결제를 한시 허용한다. **운영 정식 오픈 시 반드시 제거할 것** —
# 채널 키는 브라우저에 노출되므로, 켜 두면 실제 돈 없이 주문을 PAID로 만들 수 있다.
PORTONE_ALLOW_TEST_CHANNEL=
