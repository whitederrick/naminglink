# 인연링크 환경변수.
#
# **필수 변수가 없다.** 아무것도 설정하지 않아도 궁합 계산은 그대로 동작한다(무료 조회는
# 저장소도 결제도 쓰지 않는다). 아래는 전부 광고와 유료 PDF 판매용이고, 미설정이면 그 기능이
# 꺼진 채 배포된다 — 스크립트도, /ads.txt도, CSP 완화도 붙지 않는다.
#
# 주의: NEXT_PUBLIC_ 변수는 빌드 시점에 클라이언트 번들에 박힌다. Vercel에서 값을 넣은 뒤에는
# 반드시 **재배포**해야 반영된다.

# ── 검색 노출 ────────────────────────────────────────────────────────────
#
# 사이트 절대 주소(끝 슬래시 없이). canonical·hreflang·sitemap이 전부 이 값에서 나온다.
# 미설정 시 https://inyeonlink.vercel.app 로 떨어진다.
#
# **이 값이 색인 여부까지 정한다.** `*.vercel.app`이면 robots가 전면 Disallow를 낸다 —
# 배포 주소로 색인이 쌓인 뒤 도메인을 바꾸면 URL이 통째로 이동하기 때문이다.
# 실 도메인을 넣는 순간 색인이 열리므로 따로 켜야 하는 스위치는 없다.
NEXT_PUBLIC_SITE_URL=

# ── 개발·운영 격리 ────────────────────────────────────────────────────────
#
# 개발(로컬)과 운영(Vercel)이 같은 Supabase 프로젝트를 본다. DB를 나누는 대신 이 값으로 가른다.
# **로컬 .env.local에만 dev를 넣는다.** 기본값이 "운영"이고, Vercel 운영 배포에서는 무시된다.
# 켜면 주문이 is_test=true로 기록되어 운영 대시보드·매출 집계에서 빠진다.
APP_ENV=
# 로컬에서만 상품을 켜 본다(운영 DB의 product_settings.enabled는 건드리지 않는다).
# ALL 또는 콤마 구분 코드(예: GUNGHAP_PDF_KRW). APP_ENV=dev일 때만 동작한다.
DEV_PRODUCTS_ENABLED=

# 애드센스 퍼블리셔 ID. 형식이 맞아야만 광고가 켜진다(ca-pub- + 숫자).
# 심사를 통과해야 발급되므로 처음에는 비워 둔다.
NEXT_PUBLIC_ADSENSE_CLIENT=

# 광고 단위(슬롯) ID. 애드센스 콘솔에서 자리마다 하나씩 만든다.
# 슬롯이 비어 있으면 그 자리만 렌더링하지 않으므로, 한 자리씩 켜 볼 수 있다.
# 결과 화면 — 결과를 다 읽은 뒤
# 화면 맨 위(머리글보다 앞). 흐름 안의 자리라 스크롤하면 같이 올라간다.
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=
# 제목 옆 SLOT_HEADER 자리는 없앴다(2026-07-31). 입력 화면에 광고가 셋이 되어 콘텐츠보다 많아
# 보였고, 그 자리는 언어 선택기가 받았다 — 값을 넣어도 아무 데도 안 붙는다.
# 입력 화면 — 맨 아래(제출 버튼과 떨어진 자리)
# 화면 맨 아래(푸터 바로 위). 예전의 SLOT_FORM 자리를 이것이 대신하므로
# **SLOT_FORM은 더 이상 읽지 않는다** — 값을 넣어도 아무 데도 안 붙는다.
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
#
# **관문(계산 중 팝업)에는 애드센스를 두지 않습니다.** 예전에는 ANALYZING 슬롯이 있었으나
# 지웠습니다. 그 팝업은 화면을 덮는 오버레이이고 결과를 여는 관문이라, 표시 광고를 두면
# 오버레이 게재 금지와 보상형 금지에 동시에 걸립니다(naminglink에서 같은 이유로 걷어냄).
# 보상형이 필요하면 GAM·AdMob 보상형 포맷을 쓰세요. 기다림 자체는 그대로 돕니다.

# ── 유료 PDF 판매 (궁합 리포트: 국내 990원 / 해외 US$1.99) ─────────────────────
#
# 주문은 naminglink와 **같은 Supabase, 같은 public.orders**에 쌓이고 service 컬럼으로
# 갈린다(포트원 상점이 하나이기 때문). 그래서 아래 값들도 naminglink와 같은 것을 쓴다.
#
# 가격과 판매 여부는 코드가 아니라 DB(product_settings)가 정한다. 지금은 enabled=false로
# 시드돼 있어 값을 다 넣어도 판매가 열리지 않는다 — naminglink 관리자 화면에서 켜야 한다.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 포트원은 **해외 페이팔 전용**이다(2026-07-29 일원화). 국내 채널(카카오페이)과 단일 채널 키
# NEXT_PUBLIC_PORTONE_CHANNEL_KEY 폴백은 코드에서 제거했으므로 값을 넣어도 쓰이지 않는다.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_PAYPAL=
PORTONE_API_SECRET=

# 테스트 채널 결제를 한시 허용한다. **운영 정식 오픈 시 반드시 제거할 것** —
# 채널 키는 브라우저에 노출되므로, 켜 두면 실제 돈 없이 주문을 PAID로 만들 수 있다.
PORTONE_ALLOW_TEST_CHANNEL=

# ── 운영 알림 ──────────────────────────────────────────────────────────────
# 사람이 손대야 끝나는 일이 생겼을 때 알린다(`lib/ops-alert.ts`). 지금 부르는 자리는 셋이다 —
# 레이트리밋 확인 불가, 토스 결제 승인 실패, 결제된 리포트 발급 실패.
#
# 슬랙·디스코드 수신 웹훅 주소. 비워 두면 그쪽으로는 보내지 않는다.
OPS_ALERT_WEBHOOK_URL=
#
# 메일로 받으려면 Resend API 키를 넣는다. **naminglink와 같은 Resend 계정·같은 키를 쓴다** —
# 제목의 `[inyeon-link]` 표시로 어느 서비스인지 갈린다. SMTP 비밀번호가 아니라 대시보드
# API Keys에서 발급한 값이다(Permission은 Sending access).
RESEND_API_KEY=
# 받을 주소. 비우면 lib/company.ts의 고객센터 메일로 간다. 여러 개면 콤마로 나눈다.
OPS_ALERT_EMAIL=
# 보내는 주소. 비우면 `Inyeon-Link 알림 <alerts@naming-link.com>`이 된다.
# **인연링크 도메인이 아니다** — 이 앱은 아직 실 도메인이 없고, 인증되지 않은 도메인으로
# 보내면 Resend가 거절한다. 도메인을 붙이고 Resend에서 인증하면 그때 이 값으로 바꾼다.
OPS_ALERT_FROM=

# ── GAM 보상형 ─────────────────────────────────────────────────────────────
# 결과를 여는 대가로 보는 광고. **애드센스 표시 광고는 이 자리에 쓸 수 없다**(콘텐츠 해제의
# 대가로 쓰는 것은 정책 위반이고, 보상형은 GAM·AdMob 포맷으로만 허용된다).
#
# GAM 콘솔에서 보상형 광고 단위를 만들면 `/네트워크코드/이름` 꼴로 나온다. 비워 두면 게이트
# 자체가 사라진다 — 띄울 광고 없이 5초를 붙잡으면 이용자만 잃고 버는 것이 없기 때문이다
# (`lib/ads.ts`의 submitAdGateEnabled).
NEXT_PUBLIC_GAM_REWARDED_UNIT=

# --- 운영 상태 점검 (naming-artist 콘솔이 부른다) ---
# `/api/ops/status`를 여는 토큰. **naminglink 배포와 같은 값**을 넣는다.
# 비우면 이 엔드포인트는 503으로 닫힌다 — 응답에 boolean만 나가더라도 운영 상태를 아무나
# 긁어 갈 이유는 없다.
OPS_STATUS_TOKEN=
