# 개발(로컬)과 운영(Vercel)이 같은 Supabase 프로젝트를 봅니다. DB를 나누는 대신 이 값으로 가릅니다.
# **로컬 .env.local에만 dev를 넣으세요.** 기본값은 "운영"이고, Vercel 운영 배포에서는 무시됩니다.
# 켜면: 주문·세션이 is_test=true로 기록되고(운영 대시보드·매출에서 빠짐),
#       상품 설정·사이트 콘텐츠 저장이 403으로 막히며, 운영 DB에 붙는 스크립트가 실행됩니다.
APP_ENV=
# 로컬에서만 상품을 켜 본다(운영 DB의 product_settings.enabled는 건드리지 않음).
# ALL 또는 콤마 구분 코드(예: STAMP_KRW,CANDIDATE_UNLOCK_KRW). APP_ENV=dev일 때만 동작합니다.
DEV_PRODUCTS_ENABLED=
# 사이트 절대 주소(끝 슬래시 없이). canonical·hreflang·sitemap이 전부 이 값에서 나옵니다.
# 운영 값은 https://naming-link.com 입니다(2026-07-29 연결). 미설정 시 https://naminglink.vercel.app
# 로 떨어지고, 그 주소에서는 robots.ts가 전면 Disallow를 내므로 색인이 열리지 않습니다.
# 색인이 쌓인 뒤에 바꾸면 모든 URL이 이동하는 것이라 리다이렉트 정리가 따라붙습니다.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FREE_DAILY_LIMIT=100
# 무료 한도 방문자 해시 전용 솔트. 미설정 시 서비스 롤 키를 재사용하므로 운영에서는 반드시 설정하세요.
ANALYTICS_HASH_SALT=
ADMIN_ACCESS_TOKEN=
# 국내 결제 = 토스페이먼츠 직접 연동. **둘 다 있어야 켜진다.**
# 이 키가 있으면 국내 상품(한자 상세·일괄 공개·도장)은 포트원을 거치지 않고 토스로 간다.
# NEXT_PUBLIC_ 값은 빌드 시점에 박히므로 Vercel은 재배포, 로컬은 dev 재시작이 필요하다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 해외 결제 = 포트원 경유 페이팔. 아래 넷을 모두 요구한다(하나만 빠져도 버튼이 안 켜진다).
# **포트원은 해외 전용이다**(2026-07-29 일원화). 국내 채널(카카오페이)과 단일 채널 키
# NEXT_PUBLIC_PORTONE_CHANNEL_KEY 폴백은 코드에서 제거했으므로 값을 넣어도 쓰이지 않는다.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_PAYPAL=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
CRON_SECRET=
# 로컬 개발은 자동 활성화됩니다. 운영에서 잠시 시험할 때만 true로 설정하고 시험 후 제거하세요.
# 운영에서는 PREMIUM_TEST_MODE=true 만으로 열리지 않고, 아래 시크릿을 x-premium-test-secret 헤더로
# 함께 보내야 테스트 엔드포인트가 열립니다(시크릿 미설정 시 운영에서 항상 차단).
PREMIUM_TEST_MODE=false
PREMIUM_TEST_SECRET=

# 애드센스. **다크 런치**입니다 — 퍼블리셔 ID가 없으면 로더도 ads.txt도 CSP 완화도 붙지 않습니다.
# 슬롯 이름이 인연링크와 다릅니다(자리 구성이 달라서입니다). 값을 넣은 뒤에는 재배포해야 합니다 —
# NEXT_PUBLIC_ 값은 빌드 시점에 클라이언트 번들로 박히기 때문입니다. 자세한 것은 src/lib/ads.ts.
#
# 퍼블리셔 ID. `ca-pub-` + 숫자 형식이 맞아야만 켜집니다(오타면 조용히 꺼진 채로 둡니다).
# 심사를 통과해야 발급되므로 처음에는 비워 둡니다.
NEXT_PUBLIC_ADSENSE_CLIENT=
# 광고 단위(슬롯) ID. 애드센스 콘솔에서 **자리마다 하나씩** 만듭니다(아홉 개).
# 자리를 합치면 어느 화면이 실제로 버는지 콘솔에서 갈라 볼 수 없습니다.
# 슬롯이 비어 있으면 그 자리만 렌더링하지 않으므로, 한 자리씩 켜 볼 수 있습니다.
# 이름은 src/lib/ads.ts의 adSlots 키와 짝입니다 — 어긋나면 컴파일이 깨집니다.
#
# 입력 화면
NEXT_PUBLIC_ADSENSE_SLOT_SERVICE_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_CONSENT_CARD=
# 보상형 대기 자리
NEXT_PUBLIC_ADSENSE_SLOT_ANALYSIS_WAIT=
NEXT_PUBLIC_ADSENSE_SLOT_CANDIDATE_UNLOCK=
NEXT_PUBLIC_ADSENSE_SLOT_HANGUL_CANDIDATE_UNLOCK=
# 결과 화면 머리글(서비스별로 나눕니다)
NEXT_PUBLIC_ADSENSE_SLOT_HANJA_RESULT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_KOREAN_NAME_RESULT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_KOREAN_TO_GLOBAL_RESULT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_HANGUL_RESULT_HEADER=
